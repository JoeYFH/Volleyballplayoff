{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git",
      "**/.gitignore",
      "**/README.md",
      "functions/**"
    ],
    "rewrites": [
      { "source": "/og/**", "function": "og" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git"]
    }
  ]
}
