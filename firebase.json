{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git",
      "**/.gitignore",
      "**/README.md"
    ],
    "rewrites": [
      { "source": "/og/**", "function": "og" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
