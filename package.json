    "test:mixed": "playwright test tests/e2e/mixed.spec.js --project=chromium",
    "test:list": "playwright test tests/e2e/list.spec.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "report": "node scripts/report.js",
    "cleanup": "node scripts/cleanup-test-sessions.js"
  },
  "type": "module",
