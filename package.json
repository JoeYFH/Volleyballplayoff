  "description": "> **Volleyball Pickup Sign-up System** > 讓球友快速建立場次、線上報名的輕量 Web App。",
  "main": "firebase-config.js",
  "scripts": {
    "test": "playwright test",
    "test:male": "playwright test tests/e2e/male.spec.js --project=chromium",
